<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CivicWatch.Pages.ReportPage" Shell.NavBarIsVisible="False" BackgroundColor="#F8FAFF">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,8">
                <Button Text="←" Clicked="OnBack" WidthRequest="40" HeightRequest="40" Padding="0" CornerRadius="20" BackgroundColor="{StaticResource Soft}" TextColor="{StaticResource Ink}" />
                <Label Grid.Column="1" Text="Report a problem" Style="{StaticResource H1}" FontSize="20" VerticalOptions="Center" />
            </Grid>
            <Border x:Name="PhotoBox" BackgroundColor="{StaticResource Soft}" Stroke="#8FB0FF" StrokeDashArray="4,3" StrokeShape="RoundRectangle 16" HeightRequest="170" Padding="0">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPhoto" /></Border.GestureRecognizers>
                <Grid>
                    <Image x:Name="Preview" Aspect="AspectFill" IsVisible="False" />
                    <VerticalStackLayout x:Name="PhotoHint" VerticalOptions="Center" Spacing="4">
                        <Label Text="📷" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Add a photo" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Show us what needs attention" TextColor="{StaticResource Muted}" FontSize="13" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Label Text="Choose problem category" Style="{StaticResource Field}" />
            <Picker x:Name="Cat" Title="Select category" TextColor="{StaticResource Ink}" TitleColor="{StaticResource Muted}" />
            <Label Text="Set problem location" Style="{StaticResource Field}" />
            <Button x:Name="LocBtn" Text="📍 Use current location" Clicked="OnLoc" BackgroundColor="{StaticResource Soft}" TextColor="{StaticResource Primary}" CornerRadius="12" HeightRequest="48" />
            <Label Text="Describe the problem" Style="{StaticResource Field}" />
            <Editor x:Name="Desc" Placeholder="Add a short description of the issue..." MaxLength="500" HeightRequest="100" AutoSize="Disabled" TextChanged="OnDesc" TextColor="{StaticResource Ink}" />
            <Label x:Name="Count" Text="0/500" HorizontalOptions="End" FontSize="12" TextColor="{StaticResource Muted}" />
            <Label x:Name="Err" TextColor="#DC2626" FontSize="13" />
            <Button Text="Submit report" Style="{StaticResource Primary}" Clicked="OnSubmit" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
