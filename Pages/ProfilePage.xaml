<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CivicWatch.Pages.ProfilePage" Shell.NavBarIsVisible="False" BackgroundColor="#F8FAFF">
    <VerticalStackLayout Padding="18" Spacing="16">
        <Label Text="Profile" Style="{StaticResource H1}" />
        <Label Text="Profile settings come later." TextColor="{StaticResource Muted}" />
        <Button Text="Sign out" Style="{StaticResource Secondary}" Clicked="OnSignOut" />
    </VerticalStackLayout>
</ContentPage>
