<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CivicWatch.Pages.MockInboxPage" Shell.NavBarIsVisible="False" BackgroundColor="#F8FAFF">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12">
            <Label Text="Mock Municipal Inbox" Style="{StaticResource H1}" />
            <Label Text="Local simulation. No reports or status changes are sent. Demo data resets when the app restarts."
                   TextColor="{StaticResource Muted}" />
            <Label Text="View municipality" Style="{StaticResource Field}" />
            <Picker x:Name="MunicipalityPicker" Title="Select demo municipality" SelectedIndexChanged="OnMunicipalityChanged"
                    TextColor="{StaticResource Ink}" TitleColor="{StaticResource Muted}" />
            <Label x:Name="Empty" TextColor="{StaticResource Muted}" />
            <VerticalStackLayout x:Name="Reports" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
