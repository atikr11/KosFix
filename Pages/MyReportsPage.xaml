<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CivicWatch.Pages.MyReportsPage" Shell.NavBarIsVisible="False" BackgroundColor="#F8FAFF">
    <Grid RowDefinitions="Auto,Auto,*" Padding="18" RowSpacing="12">
        <Label Text="My Reports" Style="{StaticResource H1}" />
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="Chips" Spacing="8" />
        </ScrollView>
        <CollectionView x:Name="List" Grid.Row="2" ItemTemplate="{StaticResource ReportRow}" SelectionMode="Single" SelectionChanged="OnPick">
            <CollectionView.EmptyView><Label Text="No reports with this status yet." TextColor="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" /></CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
